# Copy to .env. Never commit .env or send keys in chat.
LLM_PROVIDER=hkgai
LLM_BASE_URL=https://api1.hkgai.net/v1
LLM_MODEL=t2_hkgai-v3_fp8_1m_e7
LLM_API_KEY=
LLM_AUTH_HEADER=Authorization
LLM_MAX_OUTPUT_TOKENS=8192
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RUN_ACTIONS=360
# auto uses native curl on Windows Python 3.11+ to avoid a HKGAI TLS stall.
LLM_TRANSPORT=auto
# Use api-key only if the course endpoint explicitly requires this header.
# Alternative: use DeepSeek only if permitted and supplied by the course.
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# Optional; without it search uses Tavily's rate-limited keyless mode.
TAVILY_API_KEY=
SANDBOX_IMAGE=campus-collab-sandbox:local
# Optional: needed only for an explicitly approved GitHub push.
GITHUB_TOKEN=
